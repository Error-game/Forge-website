{
  // Used only if the site is deployed to Cloudflare Workers from GitHub with root directory vero-residence.
  // site/ is already built and committed, so no build step is needed.
  "name": "vero-residence",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "single-page-application"
  }
}
